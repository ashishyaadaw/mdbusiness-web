{
  "info": {
    "name": "MD Business API",
    "description": "Auto-generated from routes/api/* on 2026-08-21. Folders mirror the route files. Set `base_url` to your running instance (defaults to http://localhost:8000/api). Run the two OTP-verify requests in Auth after a successful OTP send/verify to auto-capture `token` and `admin_token` from the response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" }
