  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Smart Login/Register - Request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9999999999\",\n  \"full_name\": \"Test User\",\n  \"fcm_key\": \"\"\n}" },
            "url": { "raw": "{{base_url}}/login/smart", "host": ["{{base_url}}"], "path": ["login", "smart"] },
            "description": "If the phone doesn't exist yet, this auto-registers the user and sends an OTP. Omit `otp` to trigger send; include it to verify."
          }
        },
        {
          "name": "Smart Login/Register - Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.access_token) { pm.collectionVariables.set('token', json.access_token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9999999999\",\n  \"otp\": \"1234\",\n  \"full_name\": \"Test User\",\n  \"fcm_key\": \"\"\n}" },
            "url": { "raw": "{{base_url}}/login/smart", "host": ["{{base_url}}"], "path": ["login", "smart"] },
            "description": "Saves access_token into the `token` collection variable on success."
          }
        },
        {
          "name": "Admin Login - Request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9999999999\",\n  \"full_name\": \"Admin\"\n}" },
            "url": { "raw": "{{base_url}}/admin/login", "host": ["{{base_url}}"], "path": ["admin", "login"] },
            "description": "Phone must already belong to a user with role=admin, or user lookup/creation happens via AuthService."
          }
        },
        {
          "name": "Admin Login - Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.access_token) { pm.collectionVariables.set('admin_token', json.access_token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9999999999\",\n  \"otp\": \"1234\",\n  \"full_name\": \"Admin\"\n}" },
            "url": { "raw": "{{base_url}}/admin/login", "host": ["{{base_url}}"], "path": ["admin", "login"] },
            "description": "Saves access_token into the `admin_token` collection variable on success. Use this token for the Admin/Staff/Promo Ads folders."
          }
        },
